<?xml version='1.0' encoding='utf-8'?>
<plugin>
  <name>ShiftDeck</name>
  <type>App</type>
  <file>{pluginDir}/ShiftDeck</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies>
      <pluginAppConnector>
        <type>Etch</type>
        <id>104</id>
        <asyncCallbacks>yes</asyncCallbacks>
      </pluginAppConnector>
    </dependencies>
    <parameters>
      <DescFile>{pluginDir}/ShiftDeck.xml</DescFile>
      <ImageDBFile>{pluginDir}/ShiftDeck_ALL_Images.zip</ImageDBFile>
    </parameters>
  </config>
</plugin>
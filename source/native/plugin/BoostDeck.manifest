<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>BoostDeck</name>
  <type>App</type>
  <file>{pluginDir}/BoostDeck</file>
  <config>
    <autoStart>yes</autoStart>
    <dependencies><pluginAppConnector>
      <type>Etch</type><id>100</id><asyncCallbacks>yes</asyncCallbacks>
    </pluginAppConnector></dependencies>
    <parameters><DescFile>{pluginDir}/BoostDeck.xml</DescFile><ImageDBFile>{pluginDir}/BoostDeck_ALL_Images.zip</ImageDBFile></parameters>
  </config>
</plugin>
